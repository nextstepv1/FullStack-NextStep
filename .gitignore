# ==========================================
# NextStep Root GitIgnore Configuration
# ==========================================

# 1. Node.js / JavaScript (Backend & Frontend)
**/node_modules/
**/dist/
**/build/
**/.next/
**/out/
**/.docusaurus/
.pnp
.pnp.js

# 2. Lingkungan / Rahasia / Konfigurasi Lokal
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/local.properties

# 3. Log / Diagnostik
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# 4. Berkas Sistem / OS Spesifik
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 5. Editor / IDE (Opsional - disembunyikan agar repositori bersih)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Python / Data Science / AI (Untuk Kolaborasi Tim DS/AI)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.ipynb_checkpoints/
**/.venv/
**/venv/
**/env/
**/ENV/
**/bin/
**/include/
**/lib/
**/lib64/
**/.pytest_cache/
**/.tox/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
